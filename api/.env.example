# iRoofer Lead API — environment
# Copy to .env and fill in. On GCP Cloud Run, set these as secret env vars.

# Comma-separated list of frontend origins allowed to POST leads (CORS).
# For Cloudflare Pages your URL looks like https://iroofer-contractors-web.pages.dev
ALLOWED_ORIGINS=http://localhost:3002,https://iroofer-contractors-web.pages.dev

# Basic-auth for the /admin lead inbox (server-side fetch from the Next.js /admin page)
ADMIN_USER=admin
ADMIN_PASS=change-me-strong

# SQLite file location (ephemeral on Cloud Run — mount a volume or use a managed DB for prod)
LEADS_DB=leads.db

# Email delivery — Gmail SMTP
# Use a Gmail App Password (not your main password) when 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=iroofercontractors@gmail.com
SMTP_PASS=your-gmail-app-password
LEAD_TO=iroofercontractors@gmail.com
